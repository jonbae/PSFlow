{
  "name": "ps-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "build:driver": "spago build && node parity/driver/build.mjs",
    "test:conformance": "playwright test --config examples/react-smoke/playwright.config.ts --project=conformance",
    "test:smoke": "playwright test --config examples/react-smoke/playwright.config.ts --project=smoke",
    "parity:surface": "node parity/surface/extract-upstream.ts && node parity/surface/extract-psflow.mjs && node parity/surface/diff.mjs",
    "parity:boundary": "node parity/boundary/drift.mjs && node parity/boundary/mount.mjs",
    "parity:changelog": "node parity/changelog-audit/extract-entries.mjs && node parity/changelog-audit/audit.mjs",
    "parity:system": "node parity/system/net.mjs",
    "parity:fork": "node parity/system/fork.mjs",
    "parity:coverage": "node parity/system/coverage.mjs",
    "test:audit": "node --test \"parity/changelog-audit/**/*.test.mjs\"",
    "test:surface": "node --test \"parity/surface/**/*.test.mjs\"",
    "test:boundary": "node --test \"parity/boundary/**/*.test.mjs\"",
    "test:census": "node --test \"parity/census/**/*.test.mjs\"",
    "test:compare": "node --test \"parity/system/trace-format.test.mjs\" \"parity/system/compare/**/*.test.mjs\"",
    "test:coverage": "node --test \"parity/system/coverage/**/*.test.mjs\"",
    "test:harness": "node --test \"parity/system/harness/**/*.test.mjs\" \"parity/system/corpus/**/*.test.mjs\" \"parity/system/net/**/*.test.mjs\" \"parity/driver/**/*.test.mjs\"",
    "test:harness:live": "playwright test --config parity/system/harness/playwright.config.mjs",
    "test:ci": "node --test .github/scripts/*.test.mjs",
    "build:oracle": "node oracle/esbuild.mjs"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@psflow/oracle": "file:./oracle",
    "@xyflow/react": "12.11.0",
    "@xyflow/system": "0.0.77",
    "esbuild": "^0.24.0",
    "http-server": "^14.1.1",
    "typescript": "^5.6.0"
  }
}
