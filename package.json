{
  "name": "ps-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "build:smoke": "spago build && esbuild examples/react-smoke/src/entry.js --bundle --format=esm --platform=browser --outfile=examples/react-smoke/dist/example.js",
    "test:smoke": "playwright test --config examples/react-smoke/playwright.config.ts",
    "parity:api": "node parity/layer0-api/extract-upstream.ts && node parity/layer0-api/extract-psflow.mjs && node parity/layer0-api/diff.mjs",
    "parity:boundary": "node parity/boundary/drift.mjs && node parity/boundary/mount.mjs",
    "parity:changelog": "node parity/changelog-audit/extract-entries.mjs && node parity/changelog-audit/audit.mjs",
    "test:compare": "node --test \"parity/system/**/*.test.mjs\"",
    "build:oracle": "node oracle/esbuild.mjs"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@psflow/oracle": "file:./oracle",
    "@xyflow/react": "12.11.0",
    "@xyflow/system": "0.0.77",
    "esbuild": "^0.24.0",
    "http-server": "^14.1.1",
    "typescript": "^5.6.0"
  }
}
