# Surface-parity intermediate extracts (regenerated by `npm run parity:surface`).
# The committed snapshot is parity/surface/report.md; the oracle bundle
# (oracle/index.js) is committed so `spago test` works without xyflow/.
parity/surface/upstream.json
parity/surface/psflow.json

# The driver's upstream-side bundle. Its psflow sibling is committed, because
# the vendored `xyflow/` tree is not and the conformance suite would have no
# fixtures without it; this one is only ever built beside a vendored tree that
# is already present, so committing it would be 1.4MB of nothing.
parity/driver/dist/upstream.js

# Changelog-audit intermediate extract (regenerated by `npm run parity:changelog`).
# The committed snapshot is parity/changelog-audit/{verdicts.json,report.md},
# which embed the PR titles so review survives without xyflow/.
parity/changelog-audit/entries.json

